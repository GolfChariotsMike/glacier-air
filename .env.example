# Server-only. Never commit real values. Add the same keys in Vercel → Settings → Environment Variables.

# Required for contact + hire forms (https://resend.com/api-keys)
RESEND_API_KEY=

# From address after glacierair.com.au is verified in Resend
RESEND_FROM=Glacier Air Website <website@glacierair.com.au>

# Comma-separated inbox(es). Default is service@ only; add nick@ if wanted.
CONTACT_TO=service@glacierair.com.au
# CONTACT_TO=service@glacierair.com.au,nick@glacierair.com.au

# Local only: log the payload instead of sending when RESEND_API_KEY is unset
# CONTACT_DEV_LOG=1
